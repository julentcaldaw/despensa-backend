model shop {
  id     Int    @id @default(autoincrement())
  name   String
  name_normalized String?
  userId Int
  user   user   @relation(fields: [userId], references: [id])
  shoppingList shoppingList[]
  purchaseHistory purchaseHistory[]
  @@unique([userId, name_normalized])
}

model purchaseHistory {
  id           Int        @id @default(autoincrement())
  userId       Int
  ingredientId Int
  shopId       Int?
  quantity     Float
  purchaseDate DateTime   @default(now())
  user         user       @relation(fields: [userId], references: [id])
  ingredient   ingredient @relation(fields: [ingredientId], references: [id])
  shop         shop?      @relation(fields: [shopId], references: [id])
  @@index([userId])
  @@index([ingredientId])
  @@index([shopId])
}
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model ingredient {
  id       Int                  @id @default(autoincrement())
  name     String
  category ingredient_category?
  pantry   pantry[]
  shoppingList shoppingList[]
  purchaseHistory purchaseHistory[]
}

model pantry {
  id           Int        @id @default(autoincrement())
  userId       Int
  ingredientId Int
  quantity     Float?     // Nueva cantidad
  ingredient   ingredient @relation(fields: [ingredientId], references: [id], map: "Pantry_ingredientId_rel")
  user         user       @relation(fields: [userId], references: [id], map: "Pantry_userId_rel")

  @@index([ingredientId], map: "Pantry_ingredientId_fkey")
  @@index([userId], map: "Pantry_userId_fkey")
}

model user {
  id           Int      @id @default(autoincrement())
  username     String
  email        String   @unique(map: "User_email_key")
  password     String
  refreshToken String?
  pantry       pantry[]
  shoppingList shoppingList[]
  avatar       String? 
  shops        shop[]
  purchaseHistory purchaseHistory[]
  dietRestrictions diet_restriction[]
  dietPreferences diet_preference[]
}
enum diet_restriction {
  sin_gluten
  sin_lactosa
  aplv
  frutos_secos
  cacahuetes
  marisco
  pescado
  huevo
  soja
  sesamo
  mostaza
  apio
  sulfitos
  altramuces
  diabeticos
  fodmap
  fructosa
  histamina
  hiposodica
  bajo_potasio
  bajo_purinas
  bajo_residuos
  fenilcetonuria
  astringente
}

enum diet_preference {
  none
  vegetarian
  lacto_vegetarian
  ovo_vegetarian
  vegan
  pescetarian
  keto
  paleo
}


enum ingredient_category {
  frutas_verduras
  carnes_pescados
  lacteos_huevos
  despensa_granos
  condimentos_aceites
  snacks_extras
}



model shoppingList {
  id           Int        @id @default(autoincrement())
  userId       Int
  ingredientId Int
  shopId       Int?
  bought       Boolean?   @default(false)
  quantity     Float?     
  purchaseDate DateTime?  
  user         user       @relation(fields: [userId], references: [id])
  ingredient   ingredient @relation(fields: [ingredientId], references: [id])
  shop         shop?      @relation(fields: [shopId], references: [id])
  @@index([userId])
  @@index([ingredientId])
  @@index([shopId])
  @@unique([userId, ingredientId])
}




